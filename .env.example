# Salin ke .env lalu isi. Di Vercel, isi di Project Settiafings > Environment Variables.

# MongoDB Atlas: Connect > Drivers > salin connection string (ganti <password>, tambahkan nama database)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/kontrakanku?retryWrites=true&w=majority

# String acak panjang: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# (Opsional) Hanya untuk menghapus file foto bukti LAMA bila ada. Fitur unggah bukti sudah dihapus.
BLOB_READ_WRITE_TOKEN=

# Untuk `npm run admin` (membuat super admin pertama)
SUPER_EMAIL=admin@kontrakanku.local
SUPER_PASSWORD=ganti-password-ini

# Identitas yang tercetak di kwitansi
OWNER_NAME=Rafi Akbar Muzaki
PROPERTY_NAME=Kontrakan Damai
PROPERTY_ADDRESS=Jalan Damai Raya No. 24
Kelurahan Cipete Utara, Kecamatan Kebayoran Baru
Kota Jakarta Selatan, DKI Jakarta 12150
Indonesia
# Alamat publik web untuk tautan kwitansi di WhatsApp (kosong = pakai alamat yang sedang dibuka).
# Wajib diisi di Vercel, mis. https://kontrakanku.vercel.app
PUBLIC_URL=
